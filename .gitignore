# Ralph loop artifacts
logs/
.ralph/logs/

# Node / pnpm
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/
pnpm-debug.log*

# Test / coverage
coverage/
.vitest-cache/

# Cache directories are not expected in the repo, but ignore them just in case.
.cache/
.serena/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Environment & secrets (test fixtures under test/fixtures/ are OK — they're
# meant to look like secrets, for detection testing)
.env
.env.local
.env.*.local
!test/fixtures/**/.env

.codex
tasks/

# Graphify. Keep graph outputs, skip heavy/local-only files
graphify-out/graph.html

# optional: commit for shared extraction speed, skip to keep repo small
graphify-out/cache/

# mtime-based, invalid after git clone - always gitignore this
graphify-out/manifest.json

# local token tracking, not useful to share
graphify-out/cost.json

# local build and community-label state; the build state holds an absolute path
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels*
graphify-out/.graphify_root
