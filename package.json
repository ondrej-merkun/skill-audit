{
  "name": "skill-audit-root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --dir packages/cli build",
    "build:release": "pnpm --dir packages/cli build:release",
    "test": "vitest run",
    "lint": "pnpm --dir packages/cli lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --dir packages/cli typecheck",
    "verify": "node scripts/verify-fast.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.2"
    }
  }
}
