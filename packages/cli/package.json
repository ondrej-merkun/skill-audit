{
  "name": "@ondrej-merkun/skill-audit",
  "version": "0.1.1",
  "description": "Scan AI agent skills for prompt injection and malicious code",
  "license": "Apache-2.0",
  "author": "Ondrej Merkun",
  "homepage": "https://github.com/ondrej-merkun/skill-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ondrej-merkun/skill-audit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ondrej-merkun/skill-audit/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "security",
    "prompt-injection",
    "scanner",
    "cli",
    "claude-code",
    "codex",
    "cline",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "skill-audit": "dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:release": "tsup --dts --clean",
    "test": "vitest run",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^14.0.3",
    "listr2": "^8.2.4",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/node": "^25.6.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
