{
  "name": "skill-audit",
  "version": "0.1.0",
  "description": "Scan AI agent skills for prompt injection and malicious code",
  "license": "Apache-2.0",
  "author": "Ondrej Merkun",
  "homepage": "https://github.com/ondrejmerkun/skillaudit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ondrejmerkun/skillaudit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ondrejmerkun/skillaudit/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "security",
    "prompt-injection",
    "scanner",
    "cli",
    "claude-code",
    "codex",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "skillaudit": "./dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^14.0.3",
    "listr2": "^10.2.1",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "tsup": "^8.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
